# ============================================================================
#  AI Job Application Agent — environment template
#  Copy to .env and fill in.  NEVER commit .env.  No secret is ever hard-coded
#  in source; every value below is read through backend/app/core/config.py.
# ============================================================================

# --- Core -------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_NAME="AI Job Application Agent"
LOG_LEVEL=INFO
LOG_FORMAT=json                      # json | console
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# --- Secrets (generate your own; see README "Generating secrets") ------------
# python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-64-byte-random-string
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-fernet-key
# Optional: comma-separated older Fernet keys, newest first, for key rotation.
ENCRYPTION_KEY_PREVIOUS=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- Database ---------------------------------------------------------------
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=jobagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jobagent:change-me-locally@localhost:5432/jobagent

# --- Redis / queue ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage ----------------------------------------------------------------
STORAGE_BACKEND=local                # local | s3
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
# S3 credentials come from the standard AWS provider chain (IAM role preferred).

# --- LLM (Anthropic) --------------------------------------------------------
# If unset, the app runs in DETERMINISTIC mode: templated documents, lexical
# matching only.  Everything still works; explanations are less nuanced.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high                      # low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000
LLM_ENABLED=true

# --- Job discovery ----------------------------------------------------------
DISCOVERY_INTERVAL_MINUTES=180       # scheduled sweep cadence
DISCOVERY_HTTP_TIMEOUT_SECONDS=20
DISCOVERY_USER_AGENT="JobAgent/1.0 (+personal job search; contact: you@example.com)"
DISCOVERY_MAX_CONCURRENCY=4
DISCOVERY_PER_HOST_RPS=0.5           # polite crawl rate, requests/second/host
RESPECT_ROBOTS_TXT=true              # must stay true; see docs/COMPLIANCE.md

# --- Optional partner credentials (YOUR OWN, under YOUR OWN agreement) -------
# Leave blank unless you personally hold an approved API agreement.
LINKEDIN_PARTNER_API_TOKEN=
INDEED_PUBLISHER_API_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# --- Automation safety ------------------------------------------------------
AUTOMATION_GLOBAL_ENABLED=false      # master kill-switch; UI can flip instantly
AUTO_SUBMIT_MIN_SCORE=85
DAILY_APPLICATION_LIMIT=10
JOB_MAX_AGE_HOURS=48
BROWSER_ASSISTANT_TOKEN=change-me-a-long-random-string

# --- Notifications ----------------------------------------------------------
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Job Agent <jobagent@example.com>"
SMTP_STARTTLS=true
NOTIFY_DIGEST_HOUR_LOCAL=8
NOTIFY_TIMEZONE=UTC

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Frontend (Next.js) -----------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
