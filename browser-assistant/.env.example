# ---------------------------------------------------------------------------
# jobagent-browser-assistant - local configuration
# Copy this file to .env and edit it. Never commit the real .env.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the /api/v1 prefix.
API_BASE_URL=http://localhost:8000/api/v1

# Shared secret sent as the X-Assistant-Token header. Generate it in the backend
# environment (ASSISTANT_TOKEN) and paste the same value here. Required.
BROWSER_ASSISTANT_TOKEN=

# Seconds to wait between polls when the queue is empty.
POLL_INTERVAL_SECONDS=20

# Must stay false. The assistant refuses to start when HEADLESS=true: you have to
# be able to watch every action and close the browser at any moment, and a hidden
# browser is the first step toward evading bot detection. Setting this to true is
# rejected with an error, not silently ignored.
HEADLESS=false

# Milliseconds of delay between Playwright actions. Keep it human readable so you
# can follow along and interrupt. This is for YOUR benefit, not to defeat any
# rate limiter or detection system.
SLOW_MO_MS=120

# Hard ceiling for a single application attempt. When it expires the attempt is
# reported as failed and the browser is closed.
MAX_RUNTIME_SECONDS=180

# Capture a confirmation screenshot and attach it to the submission receipt.
SCREENSHOT_ON_SUCCESS=true

# Appended to the browser's REAL user agent, never replacing it. The assistant
# identifies itself honestly; it never masks or spoofs the user agent.
ASSISTANT_USER_AGENT_SUFFIX=JobAgentBrowserAssistant/1.0 (+local; headed; human-supervised)

# true  = fill the form, stop before the submit button, explain what would happen.
# false = allow the submit click, and only when the server says may_click_submit.
# Defaults to true. Turn it off deliberately.
DRY_RUN=true
