# ============================================================================
#  Frontend environment template. Copy to .env.local and adjust.
#  Never commit .env.local.
# ============================================================================

# --- Browser-visible ---------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle at build time, so
# they are readable by anyone who loads the page. Put nothing secret here.
#
# This is the API origin the browser itself would call. In the default setup the
# browser does NOT call the API directly: it calls same-origin Next.js route
# handlers, which forward to API_INTERNAL_URL below. Keeping the traffic
# same-origin is what lets the session cookies stay httpOnly and SameSite.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Server-side only --------------------------------------------------------
# API_INTERNAL_URL is read only by server-side code: the App Router route
# handlers and the server-side proxy. It is never sent to the browser, so it can
# point at a private address that is not reachable from the public internet.
#
# Local development (API on the host):      http://localhost:8000/api/v1
# docker compose (API on the compose net):  http://api:8000/api/v1
# Single-host deploy behind nginx:          http://127.0.0.1:8000/api/v1
API_INTERNAL_URL=http://localhost:8000/api/v1

# Why this split matters: authentication tokens live in httpOnly cookies set by
# the server. The browser never holds a token in JavaScript, so an XSS bug
# cannot read one, and no token is ever placed in a URL or in localStorage. The
# route handlers attach the cookie server-side when they call API_INTERNAL_URL.
# In production the cookies are Secure, which means the whole app must be served
# over HTTPS or sign-in will not work at all. See infra/nginx.conf.
